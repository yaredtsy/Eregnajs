# Local API — copy to .env (never commit real secrets)

PORT=4000

# Supabase (same project as the dashboard; service role bypasses RLS — server only)
EREGNA_SUPABASE_URL=http://127.0.0.1:54321
EREGNA_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated browser origins allowed to call the API with cookies/Authorization
EREGNA_CORS_ORIGINS=http://localhost:3000
