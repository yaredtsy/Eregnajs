# Dashboard (TanStack Start + Vite) — copy to .env

# Supabase (browser-safe anon key). Prefer Eregna-prefixed names; VITE_SUPABASE_* still works.
VITE_EREGNA_SUPABASE_URL=https://your-project.supabase.co
VITE_EREGNA_SUPABASE_ANON_KEY=your-anon-key

# Optional legacy names:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# API base URL (Bun app). Defaults to http://localhost:4000 if unset.
VITE_EREGNA_API_URL=http://localhost:4000

# Auth: enable Email in Supabase (Authentication → Providers → Email).
# For Google OAuth, add client id/secret and redirect http://localhost:3000/auth/callback
# Site URL: http://localhost:3000
