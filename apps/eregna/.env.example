# Supabase — create a project at https://supabase.com/dashboard
# Authentication → Providers → Google: enable and add OAuth client id/secret from Google Cloud Console.
# Authentication → URL configuration: add Site URL (e.g. http://localhost:3000) and Redirect URLs including http://localhost:3000/auth/callback

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
